# short-description: Unified Phytec i.MX8M disk image (SD card)
# long-description: Creates a single partition blueprint compatible with both
# core-image-minimal and core-image-base targets.

# Use GPT table - works for both images as long as we fix the output name extension
#bootloader --ptable gpt --timeout=0

# Partition 0: Raw bootloader placement space (No table mapping)
#part U-BOOT --source rawcopy --sourceparams="file=imx-boot" --ondisk mmc --no-table --offset ${BOOTLOADER_SEEK}

# Partition 1: VFAT Boot partition - Hardcoded to 64MB (plenty for fitImage)
#part /boot --source bootimg_partition --fstype=vfat --label boot --ondisk mmc --use-uuid --active --align 4096 --size ${WKS_BOOTIMAGESIZE}

# Partition 2: Main Linux rootfs filesystem partition (auto-expands to fit the data)
#part / --source rootfs --fstype=ext4 --label root --ondisk mmc --align 1024 --use-uuid

# Partition 3: Persistent Data Container Partition - Fixed size using raw integer Megabytes (20 * 1024)
# part container --ondisk mmc --fstype=ext4 --label cntdata --align 4096 --size 20480

