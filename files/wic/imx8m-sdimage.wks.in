# short-description: Unified Phytec i.MX8M disk image (SD card)
# long-description: Creates a single partition blueprint compatible with both
# core-image-minimal and core-image-base targets by utilizing an MBR extended layout.

# Use msdos - ensures core-image-minimal compiles without missing sysroot tool errors
#bootloader --ptable msdos --timeout=0

# Partition 0: Raw bootloader placement space (No table mapping) at offset 32
#part U-BOOT --source rawcopy --sourceparams="file=imx-boot" --ondisk mmc --no-table --offset ${BOOTLOADER_SEEK}

# Primary Partition 1: VFAT Boot partition mapped to your exact expanded size
#part /boot --source bootimg_partition --fstype=vfat --label boot --ondisk mmc --use-uuid --active --align 4096 --size ${WKS_BOOTIMAGESIZE}

# Primary Partition 2: Main Linux rootfs filesystem partition
#part / --source rootfs --fstype=ext4 --label root --ondisk mmc --align 1024 --use-uuid

# Logical Partition 5 (via Primary 3 Extended): Persistent Data Container Partition
# Because it is under msdos, WIC will automatically generate an extended container slot
# to hold this massive 20GB block cleanly!
#part container --ondisk mmc --fstype=ext4 --label cntdata --align 4096 --size 20480


# ----------------------------------------------------

# short-description: Unified Phytec i.MX8M disk image
bootloader --ptable msdos --timeout=0

# Partition 0: Bootloader offset space
part U-BOOT --source rawcopy --sourceparams="file=imx-boot" --ondisk mmcblk --no-table --offset ${BOOTLOADER_SEEK}

# Primary 1: VFAT Boot
part /boot --source bootimg_partition --fstype=vfat --label boot --ondisk mmcblk --use-uuid --active --align 4096 --size ${WKS_BOOTIMAGESIZE}

# Primary 2: RootFS
part / --source rootfs --fstype=ext4 --label root --ondisk mmcblk --align 1024 --use-uuid

# Logical 5: Data Container
part container --ondisk mmcblk --fstype=ext4 --label cntdata --align 4096 --size 20480

#-------------------------------------------------

# short-description: Create a Phytec i.MX8M disk image from partup layout
# long-description: Creates a partitioned disk image for Phytec i.MX8M BSPs
# boards that the user can directly dd to an SD card and boot.

# Bootloader layout config (msdos style layout from partup.yaml)
#bootloader --ptable msdos --timeout=0

# --- RAW / BOOTLOADER SECTION ---
# Writes the raw bootloader image at the exact seek offset without adding a partition entry
#part U-BOOT --source rawcopy --sourceparams="file=${BOOTLOADER_FILE}" --ondisk mmc --no-table --offset ${BOOTLOADER_SEEK}

# --- PARTITIONS SECTION ---

# 1. Boot Partition (FAT32, 128MiB fixed size)
# In Yocto, individual boot files are managed via the IMAGE_BOOT_FILES variable in your machine configs.
#part /boot --source bootimg-partition --fstype=vfat --label boot --ondisk mmc --use-uuid --active --offset ${BOOT_PART_OFFSET} --fixed-size 128M
#part /boot --source bootimg_partition --fstype=vfat --label boot --ondisk mmc --use-uuid --active --align ${BOOT_PART_OFFSET} --size ${WKS_BOOTIMAGESIZE}

# 2. Root Filesystem Partition (ext4, expands to fill remaining space)
# Uses the pre-built ext4 raw image file requested by your partup configuration.
#part / --source rawcopy --sourceparams="file=${IMAGE_LINK_NAME}.ext4" --fstype=ext4 --label root --ondisk mmc --use-uuid --align 4096 --expand
