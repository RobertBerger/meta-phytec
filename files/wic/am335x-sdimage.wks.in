# short-description: Create a Phytec AM335x disk image (SD card)
# long-description: Creates a partitioned disk image for Phytec AM335x BSPs
# boards that the user can directly dd to an SD card and boot.

# Raw bootloaders matching layout-default-ti33x.yaml (128 KiB, 256 KiB backup, 384 KiB)
part --source rawcopy --sourceparams="file=MLO" --ondisk mmc --no-table --align 128 --size 128k
part --source rawcopy --sourceparams="file=MLO" --ondisk mmc --no-table --align 256 --size 128k
part --source rawcopy --sourceparams="file=u-boot.img" --ondisk mmc --no-table --align 384 --size 3456k

# Boot and root partitions
part --source bootimg_partition --fstype=vfat --label boot --mkfs-extraopts "-g 255/63 -a -s 8" --ondisk mmc --active --align 4096 --size ${WKS_BOOTIMAGESIZE}

# In wic (.wks.in), the root partition size is calculated dynamically from your actual rootfs content size multiplied by
# IMAGE_OVERHEAD_FACTOR (default 1.3, or 30% extra space), plus any IMAGE_ROOTFS_EXTRA_SPACE (default 0).
# Because no --size or --fixed-size flag is set on the part / line in your .wks.in file, wic sizes the partition 
# just large enough to hold your rootfs files plus that overhead.

part / --source rootfs --fstype=ext4 --label root --ondisk mmc --align 4096 --use-uuid

# 2048 MiB (2 GiB) fixed size
# part / --source rootfs --fstype=ext4 --label root --ondisk mmc --align 4096 --fixed-size 2048 --use-uuid

bootloader --ptable msdos --timeout=0
